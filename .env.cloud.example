# Supabase — Project Settings → Database → Connection string → URI (pooler)
# Port 6543 = transaction (recommandé) ; 5432 = session. Ajoutez ?sslmode=require.
DATABASE_URL=postgresql://postgres.<ref>:<mot_de_passe>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase — Project Settings → API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<cle service_role, jamais la cle anon>
SUPABASE_BUCKET=clips

# Groq — https://console.groq.com/keys (gratuit, sans carte)
GROQ_API_KEY=<cle groq>
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_LANGUAGE=fr
GROQ_RPM=20
GROQ_CHUNK_SECONDS=600

# Sélection des extraits (LLM). Réutilisez la clé de votre .env local, ou Groq.
OPENAI_API_KEY=<cle>
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Variante 100 % Groq (une seule clé) :
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=<meme cle que GROQ_API_KEY>
# OPENAI_MODEL=openai/gpt-oss-120b
# Les modeles Groq evoluent : verifier la liste disponible sur
# https://console.groq.com/docs/models (les modeles retires renvoient 404).

# Interface
APP_PASSWORD=<mot de passe pour proteger l'interface>
SECRET_KEY=<chaine aleatoire longue, ex. python -c "import secrets;print(secrets.token_hex(32))">
PORT=7860

# Déclenchement du runner GitHub Actions (interface Render + calcul Actions).
# GITHUB_REPO reste local : il n'est pas nécessaire côté worker.
GITHUB_REPO=<pseudo>/clipmaker
GITHUB_DISPATCH_TOKEN=<token GitHub classique, portee repo>
GITHUB_DISPATCH_EVENT=clipmaker-job

# Rétention des clips
RETENTION_DAYS=14
MAX_STORAGE_MB=900
JOB_RETENTION_DAYS=60
MAX_ACTIVE_JOBS=5
STALE_MINUTES=15
SIGNED_URL_SECONDS=3600

# Vidéos envoyées depuis le téléphone (bucket Supabase = 50 Mo max/fichier).
MAX_UPLOAD_MB=45
SOURCE_RETENTION_DAYS=3

# Cookies YouTube (optionnel) : ne pas les écrire ici. Utiliser
# python scripts/setup_cookies.py cookies.txt pour les mettre dans le secret
# GitHub YOUTUBE_COOKIES (48 Ko max). Sans cookies, YouTube refuse souvent les
# adresses IP de datacenter de GitHub Actions : utiliser « Envoyer une vidéo ».
